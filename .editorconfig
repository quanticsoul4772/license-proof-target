# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file for this repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Preserve trailing double-space Markdown line breaks.
[*.md]
trim_trailing_whitespace = false

# GitHub workflow/config YAML uses 2-space indentation.
[.github/**.{yml,yaml}]
indent_style = space
indent_size = 2
